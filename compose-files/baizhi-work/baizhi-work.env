# 官网：https://work.baizhi.cloud/  文档：https://work.docs.baizhi.cloud/
# 必填：设置 OMV 数据盘上的绝对目录，不要与现有安装共用目录。
BAIZHI_WORK_DATA=
# 启动前在该目录下创建 rustfs、rustfs-logs、runtime、license 子目录。
# 将这四个子目录的所有者设为 10001:10001，runtime、license 权限设为 0700。
# PostgreSQL 的 postgres 子目录由数据库容器初始化；不要修改已有数据库权限。
# 保护此环境文件（0600）；数据库、对象存储、runtime 身份、license 和命名卷均需备份。

# 已核对官方发布镜像的 linux/amd64、linux/arm64 清单；由 Docker 自动选择主机架构。
MONKEYAI_POSTGRES_IMAGE=chaitin-registry.cn-hangzhou.cr.aliyuncs.com/basic/postgres:18.6
MONKEYAI_RUSTFS_IMAGE=chaitin-registry.cn-hangzhou.cr.aliyuncs.com/basic/rustfs:v1.0.0-rc.5
MONKEYAI_MIGRATE_IMAGE=chaitin-registry.cn-hangzhou.cr.aliyuncs.com/monkeycode/monkeyai-migrate:v26111301
MONKEYAI_BACKEND_IMAGE=chaitin-registry.cn-hangzhou.cr.aliyuncs.com/monkeycode/monkeyai-backend:v26111301
MONKEYAI_ADMIN_IMAGE=chaitin-registry.cn-hangzhou.cr.aliyuncs.com/monkeycode/monkeyai-admin:v26111301

# 必填：使用独立的随机凭据，不提供通用默认密码。
# 数据库密码进入连接 URI，建议使用至少 32 位十六进制字符，避免 URI 保留字符。
POSTGRES_DB=monkeyai
POSTGRES_USER=monkeyai
POSTGRES_PASSWORD=
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=
MONKEYAI_INITIAL_ADMIN_NAME=admin
MONKEYAI_INITIAL_ADMIN_EMAIL=
MONKEYAI_INITIAL_ADMIN_PASSWORD=

# 必填：客户端实际连接的 HTTPS 根地址，与反向代理对外地址保持一致。
MONKEYAI_PUBLIC_URL=
# 默认仅监听宿主机回环地址，避免占用 OMV 的 80/443 端口。
# 请通过宿主机 HTTPS 反向代理连接 127.0.0.1:18080；容器代理需另行配置可达入口。
MONKEYAI_ADMIN_PORT=18080
MONKEYAI_HTTPS_PORT=18443
# 不分发或启用官方安装器的共用自签名证书；由反向代理终止 HTTPS。
MONKEYAI_TLS_ENABLED=false
MONKEYAI_AUTO_TLS_ENABLED=false
# 仅在使用可信反向代理时填写其直接连接地址或 CIDR，不要配置所有网段。
MONKEYAI_TRUSTED_PROXY_CIDRS=

MONKEYAI_LOG_LEVEL=warn
MONKEYAI_LOG_MAX_SIZE=20m
MONKEYAI_LOG_MAX_FILES=5
# 官方发行镜像的授权、席位与聚合统计上报行为请参阅官方安装包说明。
# 该条目不将 AGPL 源码仓库许可证等同于官方发行镜像的授权条款。
